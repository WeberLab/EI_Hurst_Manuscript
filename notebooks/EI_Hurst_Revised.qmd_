## EI

How does EI change with condition?

```{r}
gannetei_df <- as.data.frame(gannetglx_df$gannetglx / gannetgaba_df$GABAplus)
gannetei_df$Condition <- gannetgaba_df$Condition
names(gannetei_df)[1] <- "EI"
rest_gannetei <- gannetei_df %>% dplyr::filter(Condition == "Rest")
rest_gannetei <- rest_gannetei[, 1]
movie_gannetei <- gannetei_df %>% dplyr::filter(Condition == "Movie")
movie_gannetei <- movie_gannetei[, 1]
gannetei_effect_size <- cohensD(rest_gannetei, movie_gannetei)
(ttest_gannetei <- t.test(rest_gannetei, movie_gannetei, paired = TRUE))
gannetei_df$Condition <- factor(gannetei_df$Condition, levels = c("Rest", "Movie"))
gannetei_df$Sub <- gannetgaba_df$Sub
gannetei_df$Sex <- sub_dem$Sex
gannetei_m <- gannetei_df %>% dplyr::filter(Sex == "M")
gannetei_f <- gannetei_df %>% dplyr::filter(Sex == "F")
t.test(gannetei_m$EI, gannetei_f$EI)
gannetei_df$Age <- sub_dem$Age
cor.test(gannetei_df$EI, gannetei_df$Age)
```

