  ylim(minmax[1] - space, minmax[2] + space) +
  annotate(geom = "text", x = 1.5, y = minmax[2] + space / 2, label = paste(
    "mean difference [95% CI] = ",
    round(as.numeric(ttest_gannetgaba$estimate), 2),
    "[",
    round(as.numeric(ttest_gannetgaba$conf.int)[1], 2),
    " to ",
    round(as.numeric(ttest_gannetgaba$conf.int)[2], 2),
