Is Hurst correlated with glutamate?

```{r}
gannetglx <- dplyr::select(df, Rest_GlxGannet, Movie_GlxGannet)
gannetglx_cond <- gannetglx
gannetglx <- reshape2::melt(gannetglx)
gannetglx_cond <- reshape2::melt(gannetglx_cond)
gannetglx <- gannetglx[, -1]
gannetglx_cond$Condition <- gsub("_.*", "", gannetglx_cond$variable)
gannetglx_cond <- gannetglx_cond[, -1]
names(gannetglx_cond)[1] <- "Glx"
hurst <- dplyr::select(df, Rest_Hurst, Movie_Hurst)
hurst <- reshape2::melt(hurst)
hurst_cond <- hurst
hurst <- hurst[, -1]
hurst_cond$Condition <- gsub("_.*", "", hurst_cond$variable)
hurst_cond <- hurst_cond[, -1]
names(hurst_cond)[1] <- "Hurst"
gannetgh_df <- data.frame(hurst_cond$Condition, hurst_cond$Hurst, gannetglx_cond$Glx)
names(gannetgh_df) <- c("Condition", "Hurst", "Glx")

gannetgh_rest <- dplyr::filter(gh_df, Condition == "Rest")
gannetgh_rest_pearson <- cor.test(gannetgh_rest$Hurst, gannetgh_rest$Glx, method = "pearson")
print(gannetgh_rest_pearson)
gannetgh_movie <- dplyr::filter(gannetgh_df, Condition == "Movie")
gannetgh_movie_pearson <- cor.test(gannetgh_movie$Hurst, gannetgh_movie$Glx, method = "pearson")
print(gannetgh_movie_pearson)
```

```{r}
