    data = dat_text,
    mapping = aes(x = x, y = y, label = label),
    inherit.aes = FALSE
  )+
  scale_x_continuous(guide = guide_axis(angle = 40)) +
  theme(panel.spacing = unit(1, "lines")) +
  scale_fill_manual(values = c("Rest" = "green", "Movie" = "orange"))
)
png(file = "GABAplus_Hurst_Plot.png", width = 7, height = 4, units = "in", res = 300)
gabaplus_hurst_plot
dev.off()
```


Is EI correlated with Hurst?

```{r}
ei <- as.data.frame(glx / gabaplus$GABAplus)
ei$Condition <- gabaplus$Condition
names(ei)[1] <- "EI"
eih_df <- data.frame(hurst, ei)
names(eih_df)[1] <- "Hurst"
pearson_hurst_ei <- cor.test(eih_df$EI, eih_df$Hurst, method = "pearson")

eih_rest <- dplyr::filter(eih_df, Condition == "Rest")
eih_rest_pearson <- cor.test(eih_rest$Hurst, eih_rest$EI, method = "pearson")
print(eih_rest_pearson)
eih_movie <- dplyr::filter(eih_df, Condition == "Movie")
eih_movie_pearson <- cor.test(eih_movie$Hurst, eih_movie$EI, method = "pearson")
print(eih_movie_pearson)
```

```{r}
dat_text <- data.frame(
  label = c(paste("p = ", round(eih_rest_pearson$p.value, 2)), paste("p = ", round(eih_movie_pearson$p.value, 2))),
  Condition = c("Rest", "Movie"),
  x = c(2.3, 2.3),
  y = c(1.25, 1.25)
)
(ei_hurst_plot <- ggplot(data = eih_df, aes(x = EI, y = Hurst, color = Condition, fill = Condition)) +
  geom_point(color = "black") +
  geom_smooth(method = "lm", color = "blue", aes(fill = Condition), alpha = 0.3) +
  theme_classic(base_size = 12) +
  theme(
    strip.background = element_blank(), strip.text.x = element_text(size = 12, face = "bold"),
    axis.title = element_text(face = "bold"), legend.title = element_text(face = "bold")
  ) +
  theme(legend.position = "none") +
  xlab("E/I") +
  ylab("Hurst") +
  facet_wrap(~ factor(Condition, levels = c("Rest", "Movie"))) +
  geom_text(
    data = dat_text,
    mapping = aes(x = x, y = y, label = label),
    inherit.aes = FALSE
  ) +
  scale_x_continuous(guide = guide_axis(angle = 40)) +
  theme(panel.spacing = unit(1, "lines"))+
  scale_fill_manual(values = c("Rest" = "green", "Movie" = "orange"))
)
png(file = "EI_Hurst_Plot.png", width = 7, height = 4, units = "in", res = 300)
ei_hurst_plot
dev.off()
```

```{r}
layout <- "
AABB
#CC#
"
glx_hurst_plot + gabaplus_hurst_plot + ei_hurst_plot + plot_layout(design=layout, guides = 'collect', axes = 'collect', axis_titles = 'collect') + plot_annotation(tag_levels = 'A') & theme(plot.tag = element_text(size = 11))
```

# Gannet Analysis

```{r}
df <- df %>% rename(Rest_GABAGannet = Rest_mega_gannet_gabaplus, Movie_GABAGannet = Movie_mega_gannet_gabaplus, Rest_GlxGannet = Rest_mega_gannet_glx, Movie_GlxGannet = Movie_mega_gannet_glx)
```

# Linear Mixed Effects (Welch Full Freq)


```{r}
gannetdf_lme <- df %>%
  select(Subject, Rest_Hurst, Movie_Hurst,  Rest_GlxGannet, Movie_GlxGannet, Rest_GABAGannet, Movie_GABAGannet, Rest_mega_osprey_waterfwhm, Movie_mega_osprey_waterfwhm, Rest_mega_osprey_freqshift, Movie_mega_osprey_freqshift, Rest_MeanFD, Movie_MeanFD) %>%
  rename(Rest_FWHMMEGA = Rest_mega_osprey_waterfwhm, Movie_FWHMMEGA = Movie_mega_osprey_waterfwhm, Rest_FreqShiftMEGA = Rest_mega_osprey_freqshift, Movie_FreqShiftMEGA = Movie_mega_osprey_freqshift)
subjects_lme <- subjects %>% select(Age, Subject, Sex)
gannetdf_lme <- full_join(gannetdf_lme, subjects_lme, by = "Subject")
gannetdf_lme$Sex <- as.factor(gannetdf_lme$Sex)
```

```{r}
gannetdf_lme <- gannetdf_lme %>% pivot_longer(
  cols = -c(Age, Sex, Subject), # Exclude the Subject column from the transformation
  names_to = c("Condition", ".value"), # Split original column names
  names_pattern = "(.*)_(.*)" # Pattern to split the original column names
)
gannetdf_lme$EI <- gannetdf_lme$GlxGannet / gannetdf_lme$GABAGannet
gannetdf_lme$Condition <- as.factor(gannetdf_lme$Condition)
```


```{r}
gannetmodel <- lme4::lmer(Hurst ~ EI + Condition + FWHMMEGA + FreqShiftMEGA + MeanFD + (1 | Subject), data = gannetdf_lme)
summary(gannetmodel)
```
```{r}
gannetmodel <- lmerTest::lmer(Hurst ~ EI + Condition +  FWHMMEGA +  FreqShiftMEGA + MeanFD + (1 | Subject), data = gannetdf_lme)
(model_summary <- summary(model))
```

```{r}
(gannetr2_values <- performance::r2(gannetmodel))
```
```{r}
(gannetconfint_values <- lme4::confint.merMod(gannetmodel, method="Wald"))
```

```{r}
report(gannetmodel)
```

```{r}
# Plotting residuals to check assumptions
plot(resid(gannetmodel) ~ fitted(gannetmodel))
abline(h = 0, col = "red")
hist(resid(gannetmodel)) # Check for normality

# QQ plot for normality of residuals
qqnorm(resid(gannetmodel))
qqline(resid(gannetmodel))
```
## Glx

How does glutamate change with condition?

```{r}
gannetglx_df <- dplyr::select(df, Subject, Rest_GlxGannet, Movie_GlxGannet)
gannetglx_effect_size <- cohensD(gannetglx_df$Rest_GlxGannet, gannetglx_df$Movie_GlxGannet)
(ttest_gannetglx <- t.test(gannetglx_df$Rest_GlxGannet, gannetglx_df$Movie_GlxGannet, paired = TRUE))
gannetglx_df <- reshape2::melt(gannetglx_df, id.vars = c("Subject"))
gannetglx_df$variable <- gsub("_.*", "", gannetglx_df$variable)
names(gannetglx_df) <- c("Sub", "Condition", "gannetglx")
gannetglx_df$Condition <- factor(gannetglx_df$Condition, levels = c("Rest", "Movie"))

gannetglx_df$Sex <- sub_dem$Sex
gannetglx_m <- gannetglx_df %>% dplyr::filter(Sex == "M")
gannetglx_f <- gannetglx_df %>% dplyr::filter(Sex == "F")
t.test(gannetglx_m$gannetglx, gannetglx_f$gannetglx)
gannetglx_df$Age <- sub_dem$Age
cor.test(gannetglx_df$gannetglx, gannetglx_df$Age)
```

```{r}
minmax <- c(min(gannetglx_df$gannetglx), max(gannetglx_df$gannetglx))
space <- (minmax[2] - minmax[1]) / 10
(gannetglx_boxplot <- ggplot(gannetglx_df, aes(x = Condition, y = gannetglx, fill = Condition)) +
  scale_fill_manual(values = c("#98FB98", "#FFA500"), guide = "none") +
  theme_classic(base_size = 15) +
  theme(axis.title = element_text(face = "bold"), legend.position = "none") +
  geom_boxplot(outlier.shape = NA) +
  geom_point(alpha = 0.6, position = position_jitterdodge(dodge.width = 0.1, jitter.width = 0.01, seed = 123), aes(group = Sub)) +
  geom_line(aes(group = Sub), position = position_jitterdodge(dodge.width = 0.1, jitter.width = 0.01, seed = 123), alpha = 0.5) +
  ylab("Glx") +
  ylim(minmax[1] - space, minmax[2] + space) +
  annotate(geom = "text", x = 1.5, y = minmax[2] + space / 2, label = paste(
    "mean difference [95% CI] = ",
    round(as.numeric(ttest_gannetglx$estimate), 2),
    "[",
    round(as.numeric(ttest_gannetglx$conf.int)[1], 2),
    " to ",
    round(as.numeric(ttest_gannetglx$conf.int)[2], 2),
    "]",
    "\n Cohen's D = ",
    round(gannetglx_effect_size, 2)
  ))
)

png(file = "gannetglxtamate_v_Condition_Plot_Gannet.png", width = 7, height = 4, units = "in", res = 300)
gannetglx_boxplot
dev.off()
t.test(df$Rest_GlxGannet, df$Movie_GlxGannet, paired = T)
```

```{r}
(gannetglx_stats <- gannetglx_df %>% group_by(Condition) %>% summarise(mean = round(mean(gannetglx), 2), sd = round(sd(gannetglx), 2)))
```
## GABA+
How does GABA change with condition?

```{r}
gannetgaba_df <- dplyr::select(df, Subject, Rest_GABAGannet, Movie_GABAGannet)
gannetgaba_effect_size <- cohensD(gannetgaba_df$Rest_GABAGannet, gannetgaba_df$Movie_GABAGannet)
(ttest_gannetgaba <- t.test(gannetgaba_df$Rest_GABAGannet, gannetgaba_df$Movie_GABAGannet, paired = TRUE))

gannetgaba_df <- reshape2::melt(gannetgaba_df, id.vars = c("Subject"))
gannetgaba_df$variable <- gsub("_.*", "", gannetgaba_df$variable)
names(gannetgaba_df) <- c("Sub", "Condition", "GABAplus")
gannetgaba_df$Condition <- factor(gannetgaba_df$Condition, levels = c("Rest", "Movie"))

gannetgaba_df$Sub <- gannetgaba_df$Sub
gannetgaba_df$Sex <- sub_dem$Sex
gannetgaba_m <- gannetgaba_df %>% dplyr::filter(Sex == "M")
gannetgaba_f <- gannetgaba_df %>% dplyr::filter(Sex == "F")
t.test(gannetgaba_m$GABAplus, gannetgaba_f$GABAplus)
gannetgaba_df$Age <- sub_dem$Age
cor.test(gannetgaba_df$GABAplus, gannetgaba_df$Age)
```

```{r}
